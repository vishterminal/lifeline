# Copy to .env and fill in. Never commit real values.
# With everything below left blank the app runs fully in mock mode.

# --- App ---
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=change-me
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
DATABASE_URL=sqlite:///./lifeline.db
CONNECTOR_MODE=mock            # live | mock
LLM_MODE=mock                  # live | mock
TIMEZONE=Asia/Kolkata

# --- Google (Gmail, read-only) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/sources/gmail/callback
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:8000/api/auth/google/callback   # "Continue with Google"
GMAIL_POLL_MINUTES=15

# --- Twilio WhatsApp sandbox (inbound) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # sandbox number: confirm in Twilio console
TWILIO_SANDBOX_JOIN_CODE=                     # e.g. "join bright-tiger" (shown on the Connect page)

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Tunables ---
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_INGEST=60/minute
